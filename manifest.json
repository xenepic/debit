{
  "manifest_version": 3,
  "name": "イオンデビット明細CSV",
  "version": "0.1.0",
  "description": "イオンカード暮らしのマネーサイトのデビットご利用明細をCSVで保存します（Spendly取り込み用）",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://www.aeon.co.jp/app/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.aeon.co.jp/app/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.aeon.co.jp/app/*"],
      "js": ["src/relay.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "イオンデビット明細CSV",
    "default_popup": "popup/popup.html"
  }
}
